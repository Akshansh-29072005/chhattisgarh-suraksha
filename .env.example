# Application Configuration
NODE_ENV=production
PORT=5000

# Frontend API URL (used during build)
VITE_API_URL=http://localhost:5000

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chhattisgarh_suraksha
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Authentication
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRY=24h

# External APIs
# WAQI API - Get free key at: https://aqicn.org/data-platform/token/
WAQI_API_KEY=your_waqi_api_key_here

# Twilio SMS Configuration (Optional - leave empty to disable SMS)
# When TWILIO_ENABLED=false or credentials are missing, OTP will be logged to console
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Blockchain Configuration
BLOCKCHAIN_NETWORK=hardhat-local
# Set to 'true' to force contract redeployment (useful for development)
FORCE_BLOCKCHAIN_REDEPLOY=false

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Maximum requests per window per IP

# Logging Configuration
LOG_LEVEL=info  # Options: debug, info, warn, error
