import express from 'express';
import {
  getAllTopics,
  getTopicById,
  createTopic,
  updateTopic,
  deleteTopic,
  voteTopic,
  addReply,
  getReplies,
  getForumStats,
  getTopContributors,
  updateUserOnlineStatus
} from '../controllers/forum.controller.js';
import testAuthMiddleware from '../middleware/test-auth.middleware.js';

const router = express.Router();

// Mock responses for testing
const mockResponses = {
  topics: [
    {
      id: 1,
      title: 'Test Topic',
      content: 'This is a test topic content',
      category: 'air_quality',
      author_id: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
      tags: ['pollution', 'air-quality']
    }
  ]
};

// Test routes
router.get('/topics', (req, res) => {
  res.json({
    success: true,
    data: {
      topics: mockResponses.topics
    }
  });
});

router.get('/topics/:id', (req, res) => {
  const topic = mockResponses.topics.find(t => t.id === parseInt(req.params.id));
  if (!topic) {
    return res.status(404).json({
      success: false,
      error: 'Topic not found'
    });
  }
  res.json({
    success: true,
    data: {
      topic
    }
  });
});

router.post('/topics', testAuthMiddleware, (req, res) => {
  const { title, content, category, tags } = req.body;
  const newTopic = {
    id: mockResponses.topics.length + 1,
    title,
    content,
    category,
    author_id: req.user.id,
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString(),
    tags
  };
  mockResponses.topics.push(newTopic);
  res.status(201).json({
    success: true,
    data: {
      topic: newTopic
    }
  });
});

router.put('/topics/:id', testAuthMiddleware, (req, res) => {
  const { title, content, tags } = req.body;
  const topic = mockResponses.topics.find(t => t.id === parseInt(req.params.id));
  if (!topic) {
    return res.status(404).json({
      success: false,
      error: 'Topic not found'
    });
  }
  topic.title = title || topic.title;
  topic.content = content || topic.content;
  topic.tags = tags || topic.tags;
  topic.updated_at = new Date().toISOString();
  res.json({
    success: true,
    data: {
      topic
    }
  });
});

router.delete('/topics/:id', testAuthMiddleware, (req, res) => {
  const topicIndex = mockResponses.topics.findIndex(t => t.id === parseInt(req.params.id));
  if (topicIndex === -1) {
    return res.status(404).json({
      success: false,
      error: 'Topic not found'
    });
  }
  mockResponses.topics.splice(topicIndex, 1);
  res.json({
    success: true,
    message: 'Topic deleted successfully'
  });
});

router.post('/topics/:id/vote', testAuthMiddleware, (req, res) => {
  const { type } = req.body;
  const topic = mockResponses.topics.find(t => t.id === parseInt(req.params.id));
  if (!topic) {
    return res.status(404).json({
      success: false,
      error: 'Topic not found'
    });
  }
  res.json({
    success: true,
    data: {
      message: `Vote ${type} registered successfully`
    }
  });
});

router.post('/topics/:id/replies', testAuthMiddleware, (req, res) => {
  const { content } = req.body;
  const topic = mockResponses.topics.find(t => t.id === parseInt(req.params.id));
  if (!topic) {
    return res.status(404).json({
      success: false,
      error: 'Topic not found'
    });
  }
  const reply = {
    id: 1,
    content,
    topic_id: topic.id,
    author_id: req.user.id,
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString()
  };
  res.status(201).json({
    success: true,
    data: {
      reply
    }
  });
});

router.get('/topics/:id/replies', (req, res) => {
  const topic = mockResponses.topics.find(t => t.id === parseInt(req.params.id));
  if (!topic) {
    return res.status(404).json({
      success: false,
      error: 'Topic not found'
    });
  }
  res.json({
    success: true,
    data: {
      replies: []
    }
  });
});

router.get('/tags', (req, res) => {
  res.json({
    success: true,
    data: {
      tags: ['pollution', 'air-quality', 'weather', 'alert', 'health']
    }
  });
});

// Advanced forum features
router.get('/stats', (req, res) => {
  res.json({
    success: true,
    data: {
      stats: {
        totalTopics: mockResponses.topics.length,
        totalReplies: 0,
        activeUsers: 10,
        topCategories: ['air_quality', 'water_quality', 'general']
      }
    }
  });
});

router.get('/contributors', (req, res) => {
  res.json({
    success: true,
    data: {
      contributors: [
        { id: 1, username: 'test-user', contributions: 5, reputation: 100 },
        { id: 2, username: 'test-user-2', contributions: 3, reputation: 75 }
      ]
    }
  });
});

router.post('/online', testAuthMiddleware, (req, res) => {
  res.json({
    success: true,
    message: 'User online status updated'
  });
});

export default router;